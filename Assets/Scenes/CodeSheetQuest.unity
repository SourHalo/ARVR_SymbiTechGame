  m_Script: {fileID: 11500000, guid: 503c74482f661d241a4395ab390965b2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScriptSheet
  fileName: EyeLights.cs
  code: "using UnityEngine;\n\n// EyeLights.cs\n// makes the robot eyes glow (blue looks the coolest)\npublic class EyeLights : MonoBehaviour\n{\n    public Light leftEye;\n    public Light rightEye;\n    public float brightness = 2f;\n\n    void Start()\n    {\n        leftEye.color = Color.cyan;\n        rightEye.color = Color.cyan;\n    }\n\n    void Update()\n    {\n        // keep the eyes on\n        leftEye.intensity = brightness;\n        rightEye.intensity = brightness;\n    }\n}"
  isBadScript: 0
  visual: {fileID: 1793147123}
  glowFrame: {fileID: 1676589532}
  glowLight: {fileID: 1158247138}
  playerCollider: {fileID: 1322404636}
  glowColor: {r: 0.2, g: 0.9, b: 1, a: 1}
