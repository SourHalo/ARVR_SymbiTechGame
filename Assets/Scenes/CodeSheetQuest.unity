  m_Script: {fileID: 11500000, guid: 503c74482f661d241a4395ab390965b2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScriptSheet
  fileName: ArmWave.cs
  code: "using UnityEngine;\n\n// ArmWave.cs\n// waves the arms so Byte looks happy :)\npublic class ArmWave : MonoBehaviour\n{\n    public Transform leftArm;\n    public Transform rightArm;\n    public float speed = 3f;\n    public float size = 45f;\n\n    void Update()\n    {\n        // sin goes up and down between -1 and 1\n        float angle = Mathf.Sin(Time.time * speed) * size;\n        leftArm.localRotation = Quaternion.Euler(0, 0, angle);\n        rightArm.localRotation = Quaternion.Euler(0, 0, -angle);\n    }\n}"
  isBadScript: 0
  visual: {fileID: 446059927}
  glowFrame: {fileID: 937162129}
  glowLight: {fileID: 689506829}
  playerCollider: {fileID: 1322404636}
  glowColor: {r: 0.2, g: 0.9, b: 1, a: 1}
