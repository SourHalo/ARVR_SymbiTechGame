  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 503c74482f661d241a4395ab390965b2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ScriptSheet
  fileName: BatteryFix.cs
  code: "using UnityEngine;\n\n// BatteryFix.cs\n// fixes the battery so it never runs out\npublic class BatteryFix : MonoBehaviour\n{\n    public int battery = 50;\n\n    void Update()\n    {\n        // charge it every frame\n        battery = battery + 10;\n\n        // TODO: stop charging when it's full\n        if (battery > 100)\n        {\n            BlastRobot();\n        }\n    }\n\n    void BlastRobot()\n    {\n        // overcharged...\n        Destroy(gameObject);\n    }\n}"
  isBadScript: 1
  visual: {fileID: 368806686}
  glowFrame: {fileID: 529441271}
  glowLight: {fileID: 75336513}
  playerCollider: {fileID: 1322404636}
  glowColor: {r: 0.2, g: 0.9, b: 1, a: 1}
